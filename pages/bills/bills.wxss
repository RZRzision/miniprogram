page {
  background-color: #f8f8f8;
}

.container {
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.bottom-padding {
  height: 40rpx;
}

/* 支出统计卡片 */
.stats-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
}

.stat-card:last-child {
  margin-right: 0;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff8c00;
  margin-top: 8rpx;
}

/* 记一笔按钮 */
.btn-add-bill {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #ff8c00;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

/* 时间筛选：今天 / 本周 / 本月 / 全部 */
.filter-row {
  display: flex;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.filter-pill {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #666666;
  padding: 12rpx 0;
  border-radius: 26rpx;
}

.filter-pill.active {
  color: #ffffff;
  background: #ff8c00;
  font-weight: 600;
}

/* 筛选小计 */
.filter-summary {
  font-size: 22rpx;
  color: #ff8c00;
  background: #fff5eb;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

/* 按日期分组 */
.bill-groups {
  width: 100%;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx;
}

.group-date {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
}

.group-total {
  font-size: 22rpx;
  color: #ff8c00;
}

.bill-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.bill-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.bill-title-row {
  display: flex;
  align-items: center;
}

.bill-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
}

/* 分类标签 */
.bill-cat {
  font-size: 20rpx;
  color: #ff8c00;
  background: #fff5eb;
  border: 2rpx solid #ffd8b3;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 表单分类快捷标签 */
.cat-wrap {
  display: flex;
  flex-wrap: wrap;
}

.cat-chip {
  font-size: 24rpx;
  color: #666666;
  background: #f5f5f5;
  padding: 10rpx 22rpx;
  border-radius: 26rpx;
  margin: 0 12rpx 12rpx 0;
}

.cat-chip.active {
  color: #ff8c00;
  background: #fff5eb;
  border: 2rpx solid #ff8c00;
}

.bill-remark {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

.bill-time {
  font-size: 20rpx;
  color: #bbbbbb;
  margin-top: 6rpx;
}

.bill-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff8c00;
}

.bill-actions {
  display: flex;
  margin-top: 10rpx;
}

.bill-action {
  font-size: 22rpx;
  color: #ff8c00;
  background: #fff5eb;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.bill-action.del {
  color: #ff4d4f;
  background: #ffeeee;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

/* 表单弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 90;
}

.form-modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  z-index: 99;
  box-sizing: border-box;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.close-btn {
  font-size: 30rpx;
  color: #999999;
  padding: 8rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.label {
  font-size: 24rpx;
  color: #666666;
  display: block;
  margin-bottom: 8rpx;
}

.input {
  background: #fffaf5;
  border: 2rpx solid #ffd8b3;
  height: 72rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333333;
}

.picker-value {
  background: #fffaf5;
  border: 2rpx solid #ffd8b3;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333333;
}

.order-link {
  font-size: 22rpx;
  color: #ff8c00;
  background: #fff5eb;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 20rpx;
}

.btn-save {
  background-color: #ff8c00 !important;
  color: #ffffff !important;
  border-radius: 40rpx;
  font-size: 28rpx;
}


/* ===== Global visual consistency overrides ===== */
/* =========================================================
 * Page-level visual normalization
 * 仅统一视觉规格，不改变业务布局/交互。
 * ========================================================= */

/* 1. 页面基础 */
.container {
  padding-left: 20rpx !important;
  padding-right: 20rpx !important;
}

/* index 是全屏点餐页，保留其特殊布局 */
.container.headerless {}

/* 2. 卡片统一：20rpx */
.card,
.stat-card,
.stats-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.info-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.section-list,
.highlight-card,
.amount-card,
.checkout-item,
.summary-card,
.rec-card,
.menu-item,
.float-card,
.dash-hero-card,
.quick-grid,
.ds-chip,
.month-nav,
.filter-row,
.search-panel {
  border-radius: 20rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05) !important;
}

/* 3. 输入框统一：12rpx */
.input,
.textarea,
.picker-value,
.search-input-box,
.add-input,
.remark-input,
.discount-input {
  border-radius: 12rpx !important;
  border-width: 2rpx !important;
  box-sizing: border-box !important;
}

/* 搜索框是唯一的长胶囊输入控件 */
.search-input-box {
  border-radius: 999rpx !important;
}

/* 图片统一圆角；头像/圆形图标由页面自己的 50% 保持圆形 */
.dish-img,
.form-img,
.item-img,
.rec-img,
.hero-image,
.img-cell,
.diary-img {
  border-radius: 16rpx !important;
}

/* 4. 普通按钮统一：16rpx；明确的圆形按钮不覆盖 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary {
  border-radius: 16rpx !important;
}

/* 5. 胶囊统一 */
.tool-pill,
.filter-pill,
.search-chip,
.cat-chip,
.ds-chip,
.dish-chip,
.dish-tag,
.taste-tag,
.table-chip,
.back-current,
.page-tip,
.kitchen-remark,
.warn-badge,
.from-order-tag {
  border-radius: 999rpx !important;
}

/* 6. 小型状态/删除按钮统一 */
.cat-del,
.dm-clear,
.btn-delete,
.btn-delete-order,
.btn-cancel-order,
.coupon-btn.use,
.table-del {
  border-radius: 12rpx !important;
}

/* 7. 列表内分割线统一为极细浅灰 */
.card-header,
.order-header,
.dm-item,
.checkout-item,
.dish-item,
.kitchen-item,
.bill-item {
  border-bottom-color: #f0f0f0 !important;
}

/* 8. 卡片间距统一 */
.stat-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.highlight-card,
.amount-card {
  margin-bottom: 20rpx;
}

/* 9. 页面内容不要贴边 */
.empty-tip,
.empty-state,
.empty-step {
  border-radius: 20rpx !important;
}

/* 10. 触摸态，避免按钮点击时尺寸跳动 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary,
.tool-btn,
.dl-btn,
.dish-act,
.kitchen-btn,
.stock-btn,
.nav-btn {
  box-sizing: border-box;
}
