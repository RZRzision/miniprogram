page {
  background-color: #f8f8f8;
}

.container {
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.bottom-padding {
  height: 60rpx;
}

.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  font-size: 24rpx;
  color: #666666;
  display: block;
  margin-bottom: 8rpx;
}

.input {
  background: #fffaf5;
  border: 2rpx solid #ffd8b3;
  height: 72rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333333;
}

.textarea {
  background: #fffaf5;
  border: 2rpx solid #ffd8b3;
  width: 100%;
  min-height: 140rpx;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #333333;
  box-sizing: border-box;
}

.picker-value {
  background: #fffaf5;
  border: 2rpx solid #ffd8b3;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333333;
}

/* 菜品快捷点选 */
.chips-scroll {
  white-space: nowrap;
  width: 100%;
  margin-top: 12rpx;
}

.dish-chip {
  display: inline-block;
  font-size: 24rpx;
  color: #666666;
  background: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  margin-right: 12rpx;
}

.dish-chip.active {
  color: #ff8c00;
  background: #fff5eb;
  border: 2rpx solid #ff8c00;
}

/* 照片编辑 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
}

.img-cell {
  position: relative;
  margin: 0 12rpx 12rpx 0;
}

.edit-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #fff2e8;
}

.img-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #ff4d4f;
  color: #ffffff;
  font-size: 22rpx;
}

.img-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #fffaf5;
  border: 2rpx dashed #ffd8b3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

/* 评分星星 */
.stars-row {
  display: flex;
  align-items: center;
}

.star {
  font-size: 52rpx;
  color: #e0e0e0;
  margin-right: 8rpx;
}

.star.on {
  color: #ff8c00;
}

.rating-num {
  font-size: 24rpx;
  color: #999999;
  margin-left: 12rpx;
}

.order-link {
  font-size: 22rpx;
  color: #ff8c00;
  background: #fff5eb;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 24rpx;
}

.btn-save {
  background-color: #ff8c00 !important;
  color: #ffffff !important;
  border-radius: 40rpx;
  font-size: 28rpx;
}


/* ===== Global visual consistency overrides ===== */
/* =========================================================
 * Page-level visual normalization
 * 仅统一视觉规格，不改变业务布局/交互。
 * ========================================================= */

/* 1. 页面基础 */
.container {
  padding-left: 20rpx !important;
  padding-right: 20rpx !important;
}

/* index 是全屏点餐页，保留其特殊布局 */
.container.headerless {}

/* 2. 卡片统一：20rpx */
.card,
.stat-card,
.stats-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.info-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.section-list,
.highlight-card,
.amount-card,
.checkout-item,
.summary-card,
.rec-card,
.menu-item,
.float-card,
.dash-hero-card,
.quick-grid,
.ds-chip,
.month-nav,
.filter-row,
.search-panel {
  border-radius: 20rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05) !important;
}

/* 3. 输入框统一：12rpx */
.input,
.textarea,
.picker-value,
.search-input-box,
.add-input,
.remark-input,
.discount-input {
  border-radius: 12rpx !important;
  border-width: 2rpx !important;
  box-sizing: border-box !important;
}

/* 搜索框是唯一的长胶囊输入控件 */
.search-input-box {
  border-radius: 999rpx !important;
}

/* 图片统一圆角；头像/圆形图标由页面自己的 50% 保持圆形 */
.dish-img,
.form-img,
.item-img,
.rec-img,
.hero-image,
.img-cell,
.diary-img {
  border-radius: 16rpx !important;
}

/* 4. 普通按钮统一：16rpx；明确的圆形按钮不覆盖 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary {
  border-radius: 16rpx !important;
}

/* 5. 胶囊统一 */
.tool-pill,
.filter-pill,
.search-chip,
.cat-chip,
.ds-chip,
.dish-chip,
.dish-tag,
.taste-tag,
.table-chip,
.back-current,
.page-tip,
.kitchen-remark,
.warn-badge,
.from-order-tag {
  border-radius: 999rpx !important;
}

/* 6. 小型状态/删除按钮统一 */
.cat-del,
.dm-clear,
.btn-delete,
.btn-delete-order,
.btn-cancel-order,
.coupon-btn.use,
.table-del {
  border-radius: 12rpx !important;
}

/* 7. 列表内分割线统一为极细浅灰 */
.card-header,
.order-header,
.dm-item,
.checkout-item,
.dish-item,
.kitchen-item,
.bill-item {
  border-bottom-color: #f0f0f0 !important;
}

/* 8. 卡片间距统一 */
.stat-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.highlight-card,
.amount-card {
  margin-bottom: 20rpx;
}

/* 9. 页面内容不要贴边 */
.empty-tip,
.empty-state,
.empty-step {
  border-radius: 20rpx !important;
}

/* 10. 触摸态，避免按钮点击时尺寸跳动 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary,
.tool-btn,
.dl-btn,
.dish-act,
.kitchen-btn,
.stock-btn,
.nav-btn {
  box-sizing: border-box;
}
