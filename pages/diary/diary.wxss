page {
  background-color: #f8f8f8;
}

.container {
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.bottom-padding {
  height: 160rpx;
}

/* 顶部标题 + 记账本入口 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #ff8c00;
}

.header-tools {
  display: flex;
  align-items: center;
}

.tool-pill {
  font-size: 24rpx;
  color: #ff8c00;
  background: #fff5eb;
  border: 2rpx solid #ffd8b3;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  margin-left: 12rpx;
}

/* 日记列表 */
.diary-list {
  width: 100%;
}

/* 日记卡片 */
.diary-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.diary-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.diary-time {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.from-order-tag {
  font-size: 20rpx;
  color: #ff8c00;
  background: #fff5eb;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.diary-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222222;
  display: block;
  margin-top: 20rpx;
}

.dishes-row {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
}

.dishes-label {
  font-size: 24rpx;
  color: #666666;
}

.dishes-text {
  font-size: 28rpx;
  color: #333333;
  margin-top: 6rpx;
  line-height: 1.6;
}

/* 照片网格 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.diary-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin: 0 12rpx 12rpx 0;
  background: #fff2e8;
}

.img-broken {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin: 0 12rpx 12rpx 0;
  background: #f5f5f5;
  color: #bbbbbb;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.diary-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.diary-amount {
  font-size: 26rpx;
  color: #ff8c00;
  font-weight: 600;
}

.diary-stars {
  font-size: 24rpx;
  color: #ff8c00;
}

.diary-remark {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.7;
  background: #fffaf5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #f0f0f0;
}

.card-action {
  font-size: 24rpx;
  color: #ff8c00;
  background: #fff5eb;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  margin-left: 16rpx;
}

.card-action.del {
  color: #ff4d4f;
  background: #ffeeee;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 底部固定“写日记”按钮 */
.fab-btn {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #ff8c00;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 0, 0.35);
  z-index: 99;
}


/* ===== Global visual consistency overrides ===== */
/* =========================================================
 * Page-level visual normalization
 * 仅统一视觉规格，不改变业务布局/交互。
 * ========================================================= */

/* 1. 页面基础 */
.container {
  padding-left: 20rpx !important;
  padding-right: 20rpx !important;
}

/* index 是全屏点餐页，保留其特殊布局 */
.container.headerless {}

/* 2. 卡片统一：20rpx */
.card,
.stat-card,
.stats-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.info-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.section-list,
.highlight-card,
.amount-card,
.checkout-item,
.summary-card,
.rec-card,
.menu-item,
.float-card,
.dash-hero-card,
.quick-grid,
.ds-chip,
.month-nav,
.filter-row,
.search-panel {
  border-radius: 20rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05) !important;
}

/* 3. 输入框统一：12rpx */
.input,
.textarea,
.picker-value,
.search-input-box,
.add-input,
.remark-input,
.discount-input {
  border-radius: 12rpx !important;
  border-width: 2rpx !important;
  box-sizing: border-box !important;
}

/* 搜索框是唯一的长胶囊输入控件 */
.search-input-box {
  border-radius: 999rpx !important;
}

/* 图片统一圆角；头像/圆形图标由页面自己的 50% 保持圆形 */
.dish-img,
.form-img,
.item-img,
.rec-img,
.hero-image,
.img-cell,
.diary-img {
  border-radius: 16rpx !important;
}

/* 4. 普通按钮统一：16rpx；明确的圆形按钮不覆盖 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary {
  border-radius: 16rpx !important;
}

/* 5. 胶囊统一 */
.tool-pill,
.filter-pill,
.search-chip,
.cat-chip,
.ds-chip,
.dish-chip,
.dish-tag,
.taste-tag,
.table-chip,
.back-current,
.page-tip,
.kitchen-remark,
.warn-badge,
.from-order-tag {
  border-radius: 999rpx !important;
}

/* 6. 小型状态/删除按钮统一 */
.cat-del,
.dm-clear,
.btn-delete,
.btn-delete-order,
.btn-cancel-order,
.coupon-btn.use,
.table-del {
  border-radius: 12rpx !important;
}

/* 7. 列表内分割线统一为极细浅灰 */
.card-header,
.order-header,
.dm-item,
.checkout-item,
.dish-item,
.kitchen-item,
.bill-item {
  border-bottom-color: #f0f0f0 !important;
}

/* 8. 卡片间距统一 */
.stat-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.highlight-card,
.amount-card {
  margin-bottom: 20rpx;
}

/* 9. 页面内容不要贴边 */
.empty-tip,
.empty-state,
.empty-step {
  border-radius: 20rpx !important;
}

/* 10. 触摸态，避免按钮点击时尺寸跳动 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary,
.tool-btn,
.dl-btn,
.dish-act,
.kitchen-btn,
.stock-btn,
.nav-btn {
  box-sizing: border-box;
}
