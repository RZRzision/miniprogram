page {
  height: 100%;
  margin: 0;
  padding: 0;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  background-color: #f8f8f8;
  box-sizing: border-box;
  position: relative;
  margin: 0;
  padding: 0;
}

.header {
  position: relative;
  width: 100%;
  height: 180rpx;
  background-color: #fff2e8;
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.4);
}

.header-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #ff8c00;
  display: block;
}

.subtitle {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

.search-bar {
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-input-box {
  display: flex;
  align-items: center;
  background-color: #fffaf5;
  height: 72rpx;
  border-radius: 36rpx;
  padding: 0 28rpx;
  border: 2rpx solid #ffd8b3;
  box-shadow: 0 2rpx 8rpx rgba(255, 140, 0, 0.06);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

.clear-icon {
  font-size: 24rpx;
  color: #999999;
  padding: 10rpx;
}

/* 搜索历史与热门搜索 */
.search-panel {
  background: #ffffff;
  padding: 20rpx 24rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.search-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #666666;
}

.search-clear {
  font-size: 22rpx;
  color: #999999;
}

.search-chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.search-chip {
  font-size: 22rpx;
  color: #666666;
  background: #f5f5f5;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  margin: 0 12rpx 12rpx 0;
}

.search-chip.hot {
  color: #ff8c00;
  background: #fff5eb;
  border: 2rpx solid #ffd8b3;
}

/* 搜索结果行新增展示 */
.dish-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.dish-desc {
  font-size: 20rpx;
  color: #999999;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

.dish-tags {
  margin-top: 4rpx;
}

.dish-tag {
  display: inline-block;
  font-size: 18rpx;
  color: #ff8c00;
  background: #fff5eb;
  border: 2rpx solid #ffd8b3;
  border-radius: 12rpx;
  padding: 0 12rpx;
  margin-right: 8rpx;
}

.menu-item.sold-out {
  opacity: 0.55;
}

.month-sales.sold {
  color: #ff4d4f;
}

.main-body {
  flex: 1;
  width: 100%;
  display: flex;
  overflow: hidden;
}

.category-sidebar {
  width: 180rpx;
  background-color: #f5f5f5;
  height: 100%;
}

.category-item {
  padding: 34rpx 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  border-bottom: 1rpx solid #e8e8e8;
  position: relative;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.category-item.active {
  background-color: #ffffff;
  color: #ff8c00;
  font-weight: bold;
}

.category-item.active::after {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  height: 60%;
  width: 6rpx;
  background: #ff8c00;
  border-radius: 0 3rpx 3rpx 0;
}

.menu-list {
  flex: 1;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 16rpx 18rpx;
  margin-bottom: 14rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.icon {
  font-size: 36rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.price {
  font-size: 22rpx;
  color: #ff8c00;
  margin-top: 4rpx;
}

/* 菜品卡片月销 */
.month-sales {
  font-size: 20rpx;
  color: #999999;
  margin-top: 4rpx;
  white-space: nowrap;
}

.btn-select {
  margin: 0 !important;
  padding: 0 !important;
  width: 46rpx !important;
  min-width: 46rpx !important;
  height: 46rpx !important;
  line-height: 42rpx !important;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 50%;
  background-color: #2e7d32 !important;
  color: #ffffff !important;
}

/* 数量步进器（菜单列表与购物车弹窗共用） */
.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 42rpx;
  height: 42rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: bold;
  box-sizing: border-box;
}

.step-btn.minus {
  background-color: #fff5eb;
  color: #ff8c00;
  border: 2rpx solid #ffd8b3;
}

.step-btn.plus {
  background-color: #ff8c00;
  color: #ffffff;
}

.step-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #ff8c00;
}

.empty-tip {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.bottom-padding {
  height: 160rpx;
}

.cart-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 90;
}

.float-card {
  position: fixed;
  bottom: 20rpx;
  left: 30rpx;
  right: 30rpx;
  background: #ffffff;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.15);
  z-index: 99;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

.float-card.expanded {
  border-radius: 36rpx;
}

.popup-content {
  padding: 30rpx 30rpx 10rpx 30rpx;
  animation: fadeIn 0.2s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.popup-title-wrap {
  display: flex;
  flex-direction: column;
}

/* 弹窗头部操作区：全选 + 清空 */
.popup-actions {
  display: flex;
  align-items: center;
}

.check-all {
  font-size: 24rpx;
  color: #ff8c00;
  background: #fff5eb;
  border: 2rpx solid #ffd8b3;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
}

/* 结算勾选框 */
.item-check {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 34rpx;
  color: #ff8c00;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.popup-item-right {
  display: flex;
  align-items: center;
}

/* 单条删除 */
.item-del {
  font-size: 30rpx;
  margin-right: 20rpx;
  color: #ff4d4f;
}

/* 未勾选菜品置灰（仍保留在购物车） */
.item-unchecked {
  opacity: 0.45;
}

/* 数值型奖励/代价的合计展示（文案型奖励不显示） */
.total-amount {
  font-size: 20rpx;
  color: #ff8c00;
  margin-top: 4rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #888;
}

.popup-list {
  max-height: 400rpx;
  margin-top: 10rpx;
}

/* 口味备注 */
.remark-block {
  margin-top: 16rpx;
  padding: 16rpx 0 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.remark-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.remark-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
}

.remark-hint {
  font-size: 20rpx;
  color: #bbbbbb;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.taste-tag {
  font-size: 22rpx;
  color: #666666;
  background: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  margin: 0 12rpx 12rpx 0;
}

.taste-tag.active {
  color: #ff8c00;
  background: #fff5eb;
  border: 2rpx solid #ff8c00;
}

.remark-input {
  background: #fffaf5;
  border: 2rpx solid #ffd8b3;
  height: 64rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #333333;
}

.popup-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.popup-item-left {
  display: flex;
  align-items: center;
}

.popup-icon {
  font-size: 38rpx;
  margin-right: 15rpx;
}

.popup-name {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
}

.popup-price {
  font-size: 20rpx;
  color: #ff8c00;
}

/* 底部悬浮栏“共 X 份”总份数提示 */
.total-hint {
  font-size: 22rpx;
  color: #ff8c00;
  margin-left: 12rpx;
}

.footer-bar {
  height: 100rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 0 40rpx;
}

.cart-info {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.count {
  color: #ff8c00;
  font-weight: bold;
  font-size: 36rpx;
  margin: 0 6rpx;
}

.cart-icon {
  font-size: 32rpx;
  margin-left: 12rpx;
  background: #fff5eb;
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
}

.btn-submit {
  margin: 0 !important;
  width: 200rpx !important;
  height: 70rpx !important;
  line-height: 70rpx !important;
  background-color: #ff8c00 !important;
  color: #fff !important;
  border-radius: 35rpx;
  font-size: 28rpx;
  padding: 0 !important;
}

/* ===== Global visual consistency overrides ===== */
/* =========================================================
 * Page-level visual normalization
 * 仅统一视觉规格，不改变业务布局/交互。
 * ========================================================= */

/* 1. 页面基础 */
.container {
  padding-left: 20rpx !important;
  padding-right: 20rpx !important;
}

/* index 是全屏点餐页，保留其特殊布局 */
.container.headerless {}

/* 2. 卡片统一：20rpx */
.card,
.stat-card,
.stats-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.info-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.section-list,
.highlight-card,
.amount-card,
.checkout-item,
.summary-card,
.rec-card,
.menu-item,
.float-card,
.dash-hero-card,
.quick-grid,
.ds-chip,
.month-nav,
.filter-row,
.search-panel {
  border-radius: 20rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05) !important;
}

/* 3. 输入框统一：12rpx */
.input,
.textarea,
.picker-value,
.search-input-box,
.add-input,
.remark-input,
.discount-input {
  border-radius: 12rpx !important;
  border-width: 2rpx !important;
  box-sizing: border-box !important;
}

/* 搜索框是唯一的长胶囊输入控件 */
.search-input-box {
  border-radius: 999rpx !important;
}

/* 图片统一圆角；头像/圆形图标由页面自己的 50% 保持圆形 */
.dish-img,
.form-img,
.item-img,
.rec-img,
.hero-image,
.img-cell,
.diary-img {
  border-radius: 16rpx !important;
}

/* 4. 普通按钮统一：16rpx；明确的圆形按钮不覆盖 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary {
  border-radius: 16rpx !important;
}

/* 5. 胶囊统一 */
.tool-pill,
.filter-pill,
.search-chip,
.cat-chip,
.ds-chip,
.dish-chip,
.dish-tag,
.taste-tag,
.table-chip,
.back-current,
.page-tip,
.kitchen-remark,
.warn-badge,
.from-order-tag {
  border-radius: 999rpx !important;
}

/* 6. 小型状态/删除按钮统一 */
.cat-del,
.dm-clear,
.btn-delete,
.btn-delete-order,
.btn-cancel-order,
.coupon-btn.use,
.table-del {
  border-radius: 12rpx !important;
}

/* 7. 列表内分割线统一为极细浅灰 */
.card-header,
.order-header,
.dm-item,
.checkout-item,
.dish-item,
.kitchen-item,
.bill-item {
  border-bottom-color: #f0f0f0 !important;
}

/* 8. 卡片间距统一 */
.stat-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.highlight-card,
.amount-card {
  margin-bottom: 20rpx;
}

/* 9. 页面内容不要贴边 */
.empty-tip,
.empty-state,
.empty-step {
  border-radius: 20rpx !important;
}

/* 10. 触摸态，避免按钮点击时尺寸跳动 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary,
.tool-btn,
.dl-btn,
.dish-act,
.kitchen-btn,
.stock-btn,
.nav-btn {
  box-sizing: border-box;
}
