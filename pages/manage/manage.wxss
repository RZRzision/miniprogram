page {
  background-color: #f8f8f8;
}

.container {
  padding: 24rpx 20rpx; /* 与订单页、点餐页保持一致的左右 20rpx 边距 */
  box-sizing: border-box;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  color: #ff8c00;
}

.card-subtitle {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 20rpx;
}

/* 1. 上半部分表单卡片 */
.form-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 20rpx;
}

.label {
  font-size: 24rpx;
  color: #666666;
  display: block;
  margin-bottom: 8rpx;
}

.input {
  background: #fffaf5;
  border: 2rpx solid #ffd8b3; /* 加上与搜索框一致的精致浅橙色边框 */
  height: 72rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333333;
}

.picker-value {
  background: #fffaf5;
  border: 2rpx solid #ffd8b3;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333333;
}

.icon-selector {
  white-space: nowrap;
  width: 100%;
}

.icon-option {
  display: inline-block;
  font-size: 40rpx;
  padding: 10rpx 16rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.icon-option.selected {
  background: #fff0e0;
  border: 2rpx solid #ff8c00;
}

.btn-add {
  margin-top: 10rpx !important;
  background-color: #ff8c00 !important;
  color: #ffffff !important;
  border-radius: 35rpx;
  font-size: 28rpx;
}

/* 2. 下半部分列表卡片（去除过大边距，与订单卡片完全对称一致） */
.list-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  margin-bottom: 40rpx;
}

.dish-list {
  width: 100%;
}

.dish-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-info {
  display: flex;
  align-items: center;
}

.dish-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
  display: flex;
  align-items: center;
}

.tag {
  font-size: 20rpx;
  color: #ff8c00;
  background: #fff5eb;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: normal;
  margin-left: 10rpx;
}

.dish-price {
  font-size: 22rpx;
  color: #888888;
  margin-top: 6rpx;
  display: block;
}

.btn-delete {
  font-size: 24rpx;
  color: #ff4d4f;
  background: #ffeeee;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}