page {
  background-color: #f8f8f8;
}

.container {
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 用户信息卡 */
.user-card {
  background: #ff8c00;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 0, 0.3);
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 26rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  font-size: 64rpx;
  background: #ffffff;
  border-radius: 50%;
  display: block;
}

.avatar-edit {
  font-size: 18rpx;
  color: #ffffff;
  margin-top: 8rpx;
  opacity: 0.9;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname-row {
  display: flex;
  align-items: center;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nickname-edit {
  font-size: 22rpx;
  margin-left: 12rpx;
  opacity: 0.9;
}

.level-badge {
  font-size: 22rpx;
  color: #ff8c00;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
  margin-top: 12rpx;
  align-self: flex-start;
  font-weight: 600;
}

.points-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  padding: 14rpx 22rpx;
}

.points-num {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
}

.points-label {
  font-size: 20rpx;
  color: #ffffff;
  opacity: 0.9;
  margin-top: 4rpx;
}

/* 头像选择 */
.avatar-picker {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.picker-tip {
  font-size: 22rpx;
  color: #999999;
  display: block;
  margin-bottom: 12rpx;
}

.picker-row {
  display: flex;
  flex-wrap: wrap;
}

.avatar-option {
  font-size: 44rpx;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 50%;
  margin: 0 16rpx 12rpx 0;
}

.avatar-option.active {
  background: #fff5eb;
  border: 2rpx solid #ff8c00;
  box-sizing: border-box;
}

/* 会员积分明细 */
.points-panel {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.points-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666666;
  padding: 10rpx 0;
}

.p-strong {
  font-weight: bold;
  color: #ff8c00;
  font-size: 30rpx;
}

.level-bar {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  margin: 16rpx 0 12rpx;
  overflow: hidden;
}

.level-bar-inner {
  height: 100%;
  background: #ff8c00;
  border-radius: 8rpx;
}

.level-tip {
  font-size: 22rpx;
  color: #999999;
}

/* 数据统计 */
.stats-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff8c00;
}

.stat-label {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
}

.top-dish-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 30rpx;
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.top-label {
  font-size: 24rpx;
  color: #666666;
}

.top-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
}

/* 功能入口宫格 */
.menu-grid {
  background: #ffffff;
  border-radius: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx 0 8rpx;
  display: flex;
  flex-wrap: wrap;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0 22rpx;
  box-sizing: border-box;
}

.mi-icon {
  font-size: 44rpx;
}

.mi-name {
  font-size: 22rpx;
  color: #333333;
  margin-top: 10rpx;
}

/* 商家工具 */
.tool-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin-top: 20rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.tool-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 18rpx;
}

.tool-row {
  display: flex;
}

.tool-btn {
  flex: 1;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 36rpx;
  border: 2rpx solid #ffd8b3;
  background: #fffaf5;
  color: #ff8c00;
  font-size: 26rpx;
  margin-right: 20rpx;
  box-sizing: border-box;
}

.tool-btn:last-child {
  margin-right: 0;
}

.data-note {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #bbbbbb;
  margin-top: 24rpx;
}


/* ===== Global visual consistency overrides ===== */
/* =========================================================
 * Page-level visual normalization
 * 仅统一视觉规格，不改变业务布局/交互。
 * ========================================================= */

/* 1. 页面基础 */
.container {
  padding-left: 20rpx !important;
  padding-right: 20rpx !important;
}

/* index 是全屏点餐页，保留其特殊布局 */
.container.headerless {}

/* 2. 卡片统一：20rpx */
.card,
.stat-card,
.stats-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.info-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.section-list,
.highlight-card,
.amount-card,
.checkout-item,
.summary-card,
.rec-card,
.menu-item,
.float-card,
.dash-hero-card,
.quick-grid,
.ds-chip,
.month-nav,
.filter-row,
.search-panel {
  border-radius: 20rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05) !important;
}

/* 3. 输入框统一：12rpx */
.input,
.textarea,
.picker-value,
.search-input-box,
.add-input,
.remark-input,
.discount-input {
  border-radius: 12rpx !important;
  border-width: 2rpx !important;
  box-sizing: border-box !important;
}

/* 搜索框是唯一的长胶囊输入控件 */
.search-input-box {
  border-radius: 999rpx !important;
}

/* 图片统一圆角；头像/圆形图标由页面自己的 50% 保持圆形 */
.dish-img,
.form-img,
.item-img,
.rec-img,
.hero-image,
.img-cell,
.diary-img {
  border-radius: 16rpx !important;
}

/* 4. 普通按钮统一：16rpx；明确的圆形按钮不覆盖 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary {
  border-radius: 16rpx !important;
}

/* 5. 胶囊统一 */
.tool-pill,
.filter-pill,
.search-chip,
.cat-chip,
.ds-chip,
.dish-chip,
.dish-tag,
.taste-tag,
.table-chip,
.back-current,
.page-tip,
.kitchen-remark,
.warn-badge,
.from-order-tag {
  border-radius: 999rpx !important;
}

/* 6. 小型状态/删除按钮统一 */
.cat-del,
.dm-clear,
.btn-delete,
.btn-delete-order,
.btn-cancel-order,
.coupon-btn.use,
.table-del {
  border-radius: 12rpx !important;
}

/* 7. 列表内分割线统一为极细浅灰 */
.card-header,
.order-header,
.dm-item,
.checkout-item,
.dish-item,
.kitchen-item,
.bill-item {
  border-bottom-color: #f0f0f0 !important;
}

/* 8. 卡片间距统一 */
.stat-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.highlight-card,
.amount-card {
  margin-bottom: 20rpx;
}

/* 9. 页面内容不要贴边 */
.empty-tip,
.empty-state,
.empty-step {
  border-radius: 20rpx !important;
}

/* 10. 触摸态，避免按钮点击时尺寸跳动 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary,
.tool-btn,
.dl-btn,
.dish-act,
.kitchen-btn,
.stock-btn,
.nav-btn {
  box-sizing: border-box;
}
