<view class="container">
  <view class="header">
    <text class="title">📋 点餐历史记录</text>
  </view>

  <view class="order-list">
    <block wx:for="{{orders}}" wx:key="id">
      <view class="order-card">
        <view class="order-header">
          <text class="order-time">🕒 {{item.time}}</text>
          
          <!-- 右侧操作区：删除按钮 + 状态切换按钮 -->
          <view class="order-actions">
            <view class="btn-delete-order" bindtap="deleteOrder" data-id="{{item.id}}">删除订单</view>
            <view 
              class="order-status {{item.status === '已出单' ? 'completed' : ''}}" 
              bindtap="toggleStatus" 
              data-id="{{item.id}}">
              {{item.status || '已接单'}}
            </view>
          </view>
        </view>

        <view class="order-body">
          <block wx:for="{{item.items}}" wx:for-item="dish" wx:key="id">
            <view class="dish-row">
              <text class="dish-name">{{dish.icon}} {{dish.name}}</text>
              <text class="dish-price">奖励: {{dish.price}}</text>
            </view>
          </block>
        </view>
      </view>
    </block>

    <!-- 暂无订单提示 -->
    <view wx:if="{{orders.length === 0}}" class="empty-tip">
      <text class="empty-icon">🍽️</text>
      <text>还没有提交过订单哦，快去点菜吧~</text>
    </view>
  </view>
</view>