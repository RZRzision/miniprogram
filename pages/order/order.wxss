page {
  background-color: #f8f8f8;
}

.container {
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  min-height: 100vh;
  display: block;
}

.header {
  margin-bottom: 24rpx;
  text-align: center;
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  color: #ff8c00;
}

.order-list {
  width: 100%;
  display: block;
}

.order-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-header-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.order-time {
  font-size: 26rpx;
  color: #666666;
}

/* 右侧操作按钮组 */
.order-actions {
  display: flex;
  align-items: center;
}

/* 取消订单按钮（仅出餐前显示） */
.btn-cancel-order {
  font-size: 22rpx;
  color: #ff8c00;
  background-color: #fff5eb;
  border: 2rpx solid #ffd8b3;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

/* 红色删除订单按钮 */
.btn-delete-order {
  font-size: 22rpx;
  color: #ff4d4f;
  background-color: #ffeeee;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

/* 状态徽章：按生命周期状态着色（用户端清晰可见当前状态） */
.order-status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  margin-top: 10rpx;
  align-self: flex-start;
}

.order-status.status-pending {
  color: #999999;
  background: #f0f0f0;
}

.order-status.status-accepted {
  color: #ff8c00;
  background: #fff5eb;
}

.order-status.status-cooking {
  color: #e67300;
  background: #ffefd9;
}

.order-status.status-shipped {
  color: #2e7d32;
  background: #e8f5e9;
}

.order-status.status-done {
  color: #1b5e20;
  background: #dcedc8;
}

.order-status.status-cancelled {
  color: #ff4d4f;
  background: #ffeeee;
  text-decoration: line-through;
}

/* 口味备注（商家/厨房制作时可见） */
.taste-remark {
  margin-top: 16rpx;
  background: #fff5eb;
  border: 2rpx solid #ffd8b3;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}

.taste-label {
  font-size: 24rpx;
  font-weight: bold;
  color: #ff8c00;
}

.taste-text {
  font-size: 24rpx;
  color: #333333;
}

.order-body {
  padding-top: 20rpx;
}

.dish-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.dish-row:last-child {
  margin-bottom: 0;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
}

.dish-price {
  font-size: 24rpx;
  color: #ff8c00;
}

/* 订单总份数统计 */
.order-total {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #f0f0f0;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: #ff8c00;
}

/* 支付快照（实付/优惠/用餐方式） */
.order-pay {
  margin-top: 12rpx;
  text-align: right;
}

.order-pay-main {
  font-size: 26rpx;
  font-weight: bold;
  color: #ff8c00;
}

.order-pay-extra {
  font-size: 22rpx;
  color: #999999;
}

/* 便捷入口：记账 / 写日记 */
.order-tools {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f8f8f8;
}

.tool-btn {
  font-size: 24rpx;
  color: #ff8c00;
  background: #fff5eb;
  border: 2rpx solid #ffd8b3;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  margin-left: 16rpx;
}

.tool-btn.diary {
  color: #ffffff;
  background: #ff8c00;
  border: 2rpx solid #ff8c00;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* ===== Global visual consistency overrides ===== */
/* =========================================================
 * Page-level visual normalization
 * 仅统一视觉规格，不改变业务布局/交互。
 * ========================================================= */

/* 1. 页面基础 */
.container {
  padding-left: 20rpx !important;
  padding-right: 20rpx !important;
}

/* index 是全屏点餐页，保留其特殊布局 */
.container.headerless {}

/* 2. 卡片统一：20rpx */
.card,
.stat-card,
.stats-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.info-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.section-list,
.highlight-card,
.amount-card,
.checkout-item,
.summary-card,
.rec-card,
.menu-item,
.float-card,
.dash-hero-card,
.quick-grid,
.ds-chip,
.month-nav,
.filter-row,
.search-panel {
  border-radius: 20rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05) !important;
}

/* 3. 输入框统一：12rpx */
.input,
.textarea,
.picker-value,
.search-input-box,
.add-input,
.remark-input,
.discount-input {
  border-radius: 12rpx !important;
  border-width: 2rpx !important;
  box-sizing: border-box !important;
}

/* 搜索框是唯一的长胶囊输入控件 */
.search-input-box {
  border-radius: 999rpx !important;
}

/* 图片统一圆角；头像/圆形图标由页面自己的 50% 保持圆形 */
.dish-img,
.form-img,
.item-img,
.rec-img,
.hero-image,
.img-cell,
.diary-img {
  border-radius: 16rpx !important;
}

/* 4. 普通按钮统一：16rpx；明确的圆形按钮不覆盖 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary {
  border-radius: 16rpx !important;
}

/* 5. 胶囊统一 */
.tool-pill,
.filter-pill,
.search-chip,
.cat-chip,
.ds-chip,
.dish-chip,
.dish-tag,
.taste-tag,
.table-chip,
.back-current,
.page-tip,
.kitchen-remark,
.warn-badge,
.from-order-tag {
  border-radius: 999rpx !important;
}

/* 6. 小型状态/删除按钮统一 */
.cat-del,
.dm-clear,
.btn-delete,
.btn-delete-order,
.btn-cancel-order,
.coupon-btn.use,
.table-del {
  border-radius: 12rpx !important;
}

/* 7. 列表内分割线统一为极细浅灰 */
.card-header,
.order-header,
.dm-item,
.checkout-item,
.dish-item,
.kitchen-item,
.bill-item {
  border-bottom-color: #f0f0f0 !important;
}

/* 8. 卡片间距统一 */
.stat-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.highlight-card,
.amount-card {
  margin-bottom: 20rpx;
}

/* 9. 页面内容不要贴边 */
.empty-tip,
.empty-state,
.empty-step {
  border-radius: 20rpx !important;
}

/* 10. 触摸态，避免按钮点击时尺寸跳动 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary,
.tool-btn,
.dl-btn,
.dish-act,
.kitchen-btn,
.stock-btn,
.nav-btn {
  box-sizing: border-box;
}
