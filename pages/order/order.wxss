page {
  background-color: #f8f8f8;
}

.container {
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  min-height: 100vh;
  display: block;
}

.header {
  margin-bottom: 24rpx;
  text-align: center;
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  color: #ff8c00;
}

.order-list {
  width: 100%;
  display: block;
}

.order-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 26rpx;
  color: #666666;
}

/* 右侧操作按钮组 */
.order-actions {
  display: flex;
  align-items: center;
}

/* 红色删除订单按钮 */
.btn-delete-order {
  font-size: 22rpx;
  color: #ff4d4f;
  background-color: #ffeeee;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

/* 默认状态：橙色“已接单” */
.order-status {
  font-size: 24rpx;
  color: #ff8c00;
  font-weight: 500;
  background: #fff5eb;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

/* 完成状态：绿色“已出单” */
.order-status.completed {
  color: #2e7d32;
  background: #e8f5e9;
}

.order-body {
  padding-top: 20rpx;
}

.dish-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.dish-row:last-child {
  margin-bottom: 0;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
}

.dish-price {
  font-size: 24rpx;
  color: #ff8c00;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #999999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}