page {
  background-color: #f8f8f8;
}

.container {
  padding: 24rpx 20rpx; /* 统一标准的左右 20rpx 边距 */
  box-sizing: border-box;
  min-height: 100vh;
  display: block; /* 强制块级流式布局，严格自上而下排列 */
}

.header {
  margin-bottom: 24rpx;
  text-align: center;
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  color: #ff8c00;
}

/* 菜谱列表区域 */
.recipe-list {
  width: 100%;
  display: block;
}

/* 单个菜谱卡片 */
.recipe-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.recipe-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
}

.btn-delete {
  font-size: 22rpx;
  color: #ff4d4f;
  background-color: #ffeeee;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.recipe-body {
  padding-top: 20rpx;
}

.step-row {
  display: flex;
  margin-bottom: 16rpx;
}

.step-row:last-child {
  margin-bottom: 0;
}

.step-num {
  font-size: 28rpx;
  color: #ff8c00;
  font-weight: bold;
  margin-right: 12rpx;
}

.step-text {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.5;
  flex: 1;
}

.bottom-padding {
  height: 140rpx;
}

/* 右下角悬浮加号按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  line-height: 90rpx;
  background-color: #ff8c00;
  color: #ffffff;
  border-radius: 50%;
  text-align: center;
  font-size: 56rpx;
  font-weight: 300;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 0, 0.4);
  z-index: 90;
}

/* 遮罩与弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 95;
}

.recipe-modal {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  top: 15%;
  background: #ffffff;
  border-radius: 30rpx;
  padding: 30rpx;
  z-index: 99;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.close-btn {
  font-size: 32rpx;
  color: #999999;
  padding: 10rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.label {
  font-size: 24rpx;
  color: #666666;
  display: block;
  margin-bottom: 8rpx;
}

.input {
  background: #fffaf5;
  border: 2rpx solid #ffd8b3;
  height: 72rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333333;
}

.textarea {
  width: 100%;
  height: 180rpx;
  background: #fffaf5;
  border: 2rpx solid #ffd8b3;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #333333;
  box-sizing: border-box;
}

.icon-selector {
  white-space: nowrap;
  width: 100%;
}

.icon-option {
  display: inline-block;
  font-size: 40rpx;
  padding: 10rpx 16rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.icon-option.selected {
  background: #fff0e0;
  border: 2rpx solid #ff8c00;
}

.btn-submit {
  background-color: #ff8c00 !important;
  color: #ffffff !important;
  border-radius: 35rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
  color: #999999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.recipe-actions { display: flex; align-items: center; gap: 18rpx; }
.btn-edit { color: #ff8c00; font-size: 26rpx; }
.go-order { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #f3eee8; color: #ff8c00; font-size: 25rpx; text-align: right; }
.empty-step { color: #aaa; font-size: 25rpx; }


/* ===== Global visual consistency overrides ===== */
/* =========================================================
 * Page-level visual normalization
 * 仅统一视觉规格，不改变业务布局/交互。
 * ========================================================= */

/* 1. 页面基础 */
.container {
  padding-left: 20rpx !important;
  padding-right: 20rpx !important;
}

/* index 是全屏点餐页，保留其特殊布局 */
.container.headerless {}

/* 2. 卡片统一：20rpx */
.card,
.stat-card,
.stats-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.info-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.section-list,
.highlight-card,
.amount-card,
.checkout-item,
.summary-card,
.rec-card,
.menu-item,
.float-card,
.dash-hero-card,
.quick-grid,
.ds-chip,
.month-nav,
.filter-row,
.search-panel {
  border-radius: 20rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05) !important;
}

/* 3. 输入框统一：12rpx */
.input,
.textarea,
.picker-value,
.search-input-box,
.add-input,
.remark-input,
.discount-input {
  border-radius: 12rpx !important;
  border-width: 2rpx !important;
  box-sizing: border-box !important;
}

/* 搜索框是唯一的长胶囊输入控件 */
.search-input-box {
  border-radius: 999rpx !important;
}

/* 图片统一圆角；头像/圆形图标由页面自己的 50% 保持圆形 */
.dish-img,
.form-img,
.item-img,
.rec-img,
.hero-image,
.img-cell,
.diary-img {
  border-radius: 16rpx !important;
}

/* 4. 普通按钮统一：16rpx；明确的圆形按钮不覆盖 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary {
  border-radius: 16rpx !important;
}

/* 5. 胶囊统一 */
.tool-pill,
.filter-pill,
.search-chip,
.cat-chip,
.ds-chip,
.dish-chip,
.dish-tag,
.taste-tag,
.table-chip,
.back-current,
.page-tip,
.kitchen-remark,
.warn-badge,
.from-order-tag {
  border-radius: 999rpx !important;
}

/* 6. 小型状态/删除按钮统一 */
.cat-del,
.dm-clear,
.btn-delete,
.btn-delete-order,
.btn-cancel-order,
.coupon-btn.use,
.table-del {
  border-radius: 12rpx !important;
}

/* 7. 列表内分割线统一为极细浅灰 */
.card-header,
.order-header,
.dm-item,
.checkout-item,
.dish-item,
.kitchen-item,
.bill-item {
  border-bottom-color: #f0f0f0 !important;
}

/* 8. 卡片间距统一 */
.stat-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.highlight-card,
.amount-card {
  margin-bottom: 20rpx;
}

/* 9. 页面内容不要贴边 */
.empty-tip,
.empty-state,
.empty-step {
  border-radius: 20rpx !important;
}

/* 10. 触摸态，避免按钮点击时尺寸跳动 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary,
.tool-btn,
.dl-btn,
.dish-act,
.kitchen-btn,
.stock-btn,
.nav-btn {
  box-sizing: border-box;
}
