page {
  background-color: #f8f8f8;
}

.container {
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.stats-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff8c00;
}

.stat-label {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
}

.card-note {
  display: block;
  font-size: 20rpx;
  color: #bbbbbb;
  margin: 12rpx 8rpx 20rpx;
}

.section-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 18rpx;
}

.dist-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.dist-status {
  width: 110rpx;
  font-size: 24rpx;
  color: #666666;
}

.dist-bar-bg {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.dist-bar {
  height: 100%;
  background: #ff8c00;
  border-radius: 8rpx;
}

.dist-count {
  width: 60rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
}

.top-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.top-rank {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #f5f5f5;
  color: #666666;
  font-size: 24rpx;
  margin-right: 18rpx;
}

.top-rank.first {
  background: #ff8c00;
  color: #ffffff;
}

.top-name {
  flex: 1;
  font-size: 28rpx;
  color: #222222;
  font-weight: 600;
}

.top-count {
  font-size: 24rpx;
  color: #ff8c00;
}

.top-empty {
  font-size: 24rpx;
  color: #999999;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  font-size: 90rpx;
  margin-bottom: 20rpx;
}

.empty-tip text {
  font-size: 26rpx;
  color: #999999;
}


/* ===== Global visual consistency overrides ===== */
/* =========================================================
 * Page-level visual normalization
 * 仅统一视觉规格，不改变业务布局/交互。
 * ========================================================= */

/* 1. 页面基础 */
.container {
  padding-left: 20rpx !important;
  padding-right: 20rpx !important;
}

/* index 是全屏点餐页，保留其特殊布局 */
.container.headerless {}

/* 2. 卡片统一：20rpx */
.card,
.stat-card,
.stats-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.info-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.section-list,
.highlight-card,
.amount-card,
.checkout-item,
.summary-card,
.rec-card,
.menu-item,
.float-card,
.dash-hero-card,
.quick-grid,
.ds-chip,
.month-nav,
.filter-row,
.search-panel {
  border-radius: 20rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05) !important;
}

/* 3. 输入框统一：12rpx */
.input,
.textarea,
.picker-value,
.search-input-box,
.add-input,
.remark-input,
.discount-input {
  border-radius: 12rpx !important;
  border-width: 2rpx !important;
  box-sizing: border-box !important;
}

/* 搜索框是唯一的长胶囊输入控件 */
.search-input-box {
  border-radius: 999rpx !important;
}

/* 图片统一圆角；头像/圆形图标由页面自己的 50% 保持圆形 */
.dish-img,
.form-img,
.item-img,
.rec-img,
.hero-image,
.img-cell,
.diary-img {
  border-radius: 16rpx !important;
}

/* 4. 普通按钮统一：16rpx；明确的圆形按钮不覆盖 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary {
  border-radius: 16rpx !important;
}

/* 5. 胶囊统一 */
.tool-pill,
.filter-pill,
.search-chip,
.cat-chip,
.ds-chip,
.dish-chip,
.dish-tag,
.taste-tag,
.table-chip,
.back-current,
.page-tip,
.kitchen-remark,
.warn-badge,
.from-order-tag {
  border-radius: 999rpx !important;
}

/* 6. 小型状态/删除按钮统一 */
.cat-del,
.dm-clear,
.btn-delete,
.btn-delete-order,
.btn-cancel-order,
.coupon-btn.use,
.table-del {
  border-radius: 12rpx !important;
}

/* 7. 列表内分割线统一为极细浅灰 */
.card-header,
.order-header,
.dm-item,
.checkout-item,
.dish-item,
.kitchen-item,
.bill-item {
  border-bottom-color: #f0f0f0 !important;
}

/* 8. 卡片间距统一 */
.stat-card,
.section-card,
.form-card,
.list-card,
.recipe-card,
.review-card,
.order-card,
.diary-card,
.coupon-card,
.stock-item,
.cat-item,
.table-card,
.kitchen-card,
.highlight-card,
.amount-card {
  margin-bottom: 20rpx;
}

/* 9. 页面内容不要贴边 */
.empty-tip,
.empty-state,
.empty-step {
  border-radius: 20rpx !important;
}

/* 10. 触摸态，避免按钮点击时尺寸跳动 */
.btn-save,
.btn-submit,
.btn-submit-order,
.btn-add,
.add-btn,
.btn-add-bill,
.export-btn,
.coupon-btn,
.go-order,
.primary,
.tool-btn,
.dl-btn,
.dish-act,
.kitchen-btn,
.stock-btn,
.nav-btn {
  box-sizing: border-box;
}
